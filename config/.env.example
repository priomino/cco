# Claude Code Offline - environment defaults (copy to .env; .env is git-ignored)
COMPOSE_PROJECT_NAME=cco
# cpu | igpu
CCO_ENGINE_PROFILE=cpu
# Optional diagnostic port, bound to 127.0.0.1 only
CCO_DIAG_PORT=18400

# --- Engine image build ---
# Tracks the latest Unsloth release by default. To pin, set an exact version (for example 2026.9.14).
CCO_UNSLOTH_VERSION=latest
# Optional: SHA-256 of install.sh to verify. Empty = not verified (see docs/04-upgrading.md).
CCO_UNSLOTH_INSTALLER_SHA256=
CCO_ENGINE_PYTHON=3.12
CCO_ENGINE_IMAGE=cco-engine

# --- Model download ---
CCO_MODEL_REPO=bartowski/Qwen2.5-7B-Instruct-GGUF
CCO_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# Optional: expected SHA-256. Empty = use the checksum published by Hugging Face.
CCO_MODEL_SHA256=

# --- Engine runtime ---
# Context window in tokens (the model's native maximum is 32768; Claude Code needs a large window)
CCO_ENGINE_CONTEXT=32768
# CCO_STUDIO_PASSWORD is generated into config/.env by the scripts. Never commit it.

# --- Claude Code container ---
# Tracks the latest Claude Code release by default (official native installer). Set an exact version to pin.
CCO_CLAUDE_VERSION=latest
CCO_CLAUDE_IMAGE=cco-claude
# Claude Code mode: bare (about 1,000 tokens, tools Bash/Read/Edit), lean (about 3,000 tokens, adds Write), full (about 17,000 tokens)
CCO_CLAUDE_MODE=bare
# Sampling temperature pinned on the engine for requests that omit it (lower = steadier tool calls). 0.7 is the model's usual default.
CCO_ENGINE_TEMPERATURE=0.7